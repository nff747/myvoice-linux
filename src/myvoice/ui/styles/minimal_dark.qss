/*
  MyVoice Linux — Premium Dark Theme
  Inspired by modern productivity tools: Notion, Linear, Vercel
*/

/* ─── GLOBAL ─────────────────────────────────────────────── */
* {
    outline: none;
}

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: 'Inter', 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
    font-size: 10pt;
    selection-background-color: #2f81f7;
    selection-color: #ffffff;
}

/* ─── MAIN WINDOW ────────────────────────────────────────── */
QMainWindow {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 12px;
}

/* ─── TITLE BAR ──────────────────────────────────────────── */
QWidget[objectName="custom_title_bar"] {
    background-color: #161b22;
    border-bottom: 1px solid #21262d;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 40px;
    max-height: 40px;
}

QLabel[objectName="title_label"] {
    color: #7d8590;
    font-size: 10pt;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding-left: 10px;
    background: transparent;
}

QPushButton[objectName="minimize_button"],
QPushButton[objectName="maximize_button"],
QPushButton[objectName="close_button"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    color: #7d8590;
    font-size: 13px;
    padding: 0px;
}

QPushButton[objectName="minimize_button"]:hover,
QPushButton[objectName="maximize_button"]:hover {
    background-color: #21262d;
    color: #e6edf3;
}

QPushButton[objectName="close_button"]:hover {
    background-color: rgba(248, 81, 73, 0.15);
    color: #f85149;
}

/* ─── TEXT INPUT ─────────────────────────────────────────── */
QTextEdit {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 10px;
    padding: 14px 16px;
    color: #e6edf3;
    font-size: 11pt;
    line-height: 1.5;
}

QTextEdit:focus {
    border-color: #2f81f7;
    background-color: #161b22;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ─── ACTION BUTTONS (right sidebar) ────────────────────── */
QPushButton[objectName="generate_button"],
QPushButton[objectName="replay_button"],
QPushButton[objectName="quick_speak_button"],
QPushButton[objectName="clear_button"] {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    color: #7d8590;
    font-size: 14px;
}

QPushButton[objectName="generate_button"]:hover,
QPushButton[objectName="quick_speak_button"]:hover,
QPushButton[objectName="replay_button"]:hover,
QPushButton[objectName="clear_button"]:hover {
    background-color: #30363d;
    border-color: #484f58;
    color: #e6edf3;
}

QPushButton[objectName="generate_button"]:pressed,
QPushButton[objectName="quick_speak_button"]:pressed,
QPushButton[objectName="replay_button"]:pressed,
QPushButton[objectName="clear_button"]:pressed {
    background-color: #2f81f7;
    border-color: #2f81f7;
    color: white;
}

/* Generate button special accent */
QPushButton[objectName="generate_button"] {
    background-color: rgba(47, 129, 247, 0.15);
    border-color: rgba(47, 129, 247, 0.4);
    color: #2f81f7;
}

QPushButton[objectName="generate_button"]:hover {
    background-color: rgba(47, 129, 247, 0.25);
    border-color: #2f81f7;
    color: #79c0ff;
}

/* ─── EMOTION BUTTONS ────────────────────────────────────── */
QPushButton[objectName^="emotion_button_"] {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    min-width: 34px;
    max-width: 34px;
    min-height: 30px;
    max-height: 30px;
    font-size: 14pt;
    padding: 0px;
    color: #e6edf3;
}

QPushButton[objectName^="emotion_button_"]:hover {
    background-color: #21262d;
    border-color: #30363d;
}

QPushButton[objectName^="emotion_button_"]:checked {
    background-color: rgba(47, 129, 247, 0.15);
    border: 1.5px solid #2f81f7;
}

/* Custom emotion button */
QPushButton[objectName="emotion_custom_button"] {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    color: #7d8590;
    font-size: 9pt;
    font-weight: 500;
}

QPushButton[objectName="emotion_custom_button"]:hover {
    background-color: #21262d;
    border-color: #30363d;
    color: #e6edf3;
}

QPushButton[objectName="emotion_custom_button"]:checked {
    background-color: rgba(47, 129, 247, 0.15);
    border: 1.5px solid #2f81f7;
    color: #79c0ff;
}

/* ─── VOICE LABEL ────────────────────────────────────────── */
QLabel[objectName="voice_label"] {
    color: #7d8590;
    font-size: 9pt;
    font-weight: 500;
    padding: 0 8px;
    background: transparent;
}

/* ─── SETTINGS BUTTON ────────────────────────────────────── */
QPushButton[objectName="settings_button"] {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    color: #7d8590;
}

QPushButton[objectName="settings_button"]:hover {
    background-color: #21262d;
    border-color: #30363d;
    color: #e6edf3;
}

/* ─── GENERAL FALLBACK BUTTONS ───────────────────────────── */
QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #484f58;
}

QPushButton:pressed {
    background-color: #2f81f7;
    border-color: #2f81f7;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #161b22;
    color: #484f58;
    border-color: #21262d;
}

/* ─── STATUS BAR ─────────────────────────────────────────── */
QStatusBar {
    background-color: #161b22;
    color: #7d8590;
    border-top: 1px solid #21262d;
    font-size: 9pt;
    padding: 0 8px;
    min-height: 26px;
}

QStatusBar::item {
    border: none;
}

/* ─── COMBO BOX ──────────────────────────────────────────── */
QComboBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6edf3;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #484f58;
}

QComboBox:focus {
    border-color: #2f81f7;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    selection-background-color: #1f2937;
    selection-color: #e6edf3;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #21262d;
}

/* ─── LIST / TREE VIEWS ──────────────────────────────────── */
QListWidget,
QTreeWidget {
    background-color: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item,
QTreeWidget::item {
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 28px;
    color: #c9d1d9;
}

QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: rgba(47, 129, 247, 0.15);
    color: #e6edf3;
    border: 1px solid rgba(47, 129, 247, 0.3);
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: #21262d;
}

/* ─── LABELS ─────────────────────────────────────────────── */
QLabel {
    color: #c9d1d9;
    background: transparent;
}

/* ─── LINE EDIT ──────────────────────────────────────────── */
QLineEdit {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6edf3;
    min-height: 28px;
}

QLineEdit:focus {
    border-color: #2f81f7;
}

/* ─── DIALOGS ────────────────────────────────────────────── */
QDialog {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}

/* ─── SLIDERS ────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: #21262d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #2f81f7;
    border: none;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin: -5px 0;
}

QSlider::sub-page:horizontal {
    background: #2f81f7;
    border-radius: 2px;
}

/* ─── TOOLTIPS ───────────────────────────────────────────── */
QToolTip {
    background-color: #1c2128;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 9pt;
}

/* ─── CHECKBOXES ─────────────────────────────────────────── */
QCheckBox {
    color: #c9d1d9;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #30363d;
    background-color: #21262d;
}

QCheckBox::indicator:checked {
    background-color: #2f81f7;
    border-color: #2f81f7;
}

QCheckBox::indicator:hover {
    border-color: #484f58;
}

/* ─── SEPARATORS ─────────────────────────────────────────── */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #21262d;
    border: none;
    background-color: #21262d;
    max-height: 1px;
}

/* ─── MENU BAR ───────────────────────────────────────────── */
QMenuBar {
    background-color: #161b22;
    color: #c9d1d9;
    border-bottom: 1px solid #21262d;
}

QMenuBar::item:selected {
    background-color: #21262d;
    border-radius: 4px;
}

QMenu {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #21262d;
}

/* ─── TAB WIDGET ─────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 8px;
    background-color: #161b22;
}

QTabBar::tab {
    background-color: transparent;
    color: #7d8590;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #21262d;
    color: #e6edf3;
}

QTabBar::tab:hover {
    color: #c9d1d9;
}

/* ─── SPIN BOX ───────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6edf3;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2f81f7;
}

/* ─── VOICE PICKER BUTTON ────────────────────────────────── */
QPushButton[objectName="voice_picker_button"] {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 0 10px;
    color: #c9d1d9;
    font-size: 10pt;
    font-weight: 500;
    min-height: 30px;
    max-height: 30px;
    text-align: left;
}

QPushButton[objectName="voice_picker_button"]:hover {
    background-color: #21262d;
    border-color: #484f58;
    color: #e6edf3;
}

QPushButton[objectName="voice_picker_button"]:pressed {
    background-color: #2f81f7;
    border-color: #2f81f7;
    color: white;
}

/* ─── CLONE VOICE BUTTON ─────────────────────────────────── */
QPushButton[objectName="clone_voice_button"] {
    background-color: rgba(46, 160, 67, 0.12);
    border: 1px solid rgba(46, 160, 67, 0.4);
    border-radius: 8px;
    padding: 0 12px;
    color: #3fb950;
    font-size: 9pt;
    font-weight: 600;
    min-height: 30px;
    max-height: 30px;
}

QPushButton[objectName="clone_voice_button"]:hover {
    background-color: rgba(46, 160, 67, 0.22);
    border-color: #3fb950;
    color: #56d364;
}

QPushButton[objectName="clone_voice_button"]:pressed {
    background-color: rgba(46, 160, 67, 0.35);
}
